# =============================================================================
# ExplainPhish Autonomous SOC Workstation - LLM & Agent Configuration
# =============================================================================
# ExplainPhish automatically detects and supports multiple LLM providers.
# If no API key is provided, the agent falls back to its built-in offline
# Cognitive Forensics Reasoner.
#
# Choose your preferred provider and set its API key below:

# --- Option 1: Google Gemini (Recommended for fast & multimodal triage) ---
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# --- Option 2: OpenAI (GPT-4o, GPT-4o-mini) ---
OPENAI_API_KEY=

# --- Option 3: Groq (Ultra-low latency Qwen / GPT-OSS / Meta Prompt Guard) ---
# ExplainPhish automatically uses 'qwen/qwen3.8-27b' with cascading fallback
# to 'openai/gpt-oss-120b' / 'openai/gpt-oss-20b' when rate-limited.
# It also uses 'meta-llama/llama-prompt-guard-2-22m' for prompt-injection defense.
GROQ_API_KEY= 

# --- Option 4: Anthropic (Claude 3.5 Sonnet) ---
ANTHROPIC_API_KEY=

# --- Option 5: Local Ollama (100% Offline & Private) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:latest

# --- Model Selection Override (Optional) ---
# EXPLAINPHISH_LLM_MODEL=qwen/qwen3.8-27b
# EXPLAINPHISH_LLM_MODEL=openai/gpt-oss-120b
# EXPLAINPHISH_LLM_MODEL=gemini/gemini-2.5-flash
# EXPLAINPHISH_LLM_MODEL=openai/gpt-4o-mini
