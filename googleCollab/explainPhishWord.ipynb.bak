   "source": [
    "# Extract feature arrays\n",
    "X = train[core_features].values\n",
    "y = train[\"TARGET\"].values\n",
    "X_test = test[core_features].values\n",
    "\n",
    "# Standardization\n",
    "sc = StandardScaler()\n",
    "sc.fit(X)\n",
    "X_std = sc.transform(X)\n",
    "X_test_std = sc.transform(X_test)\n",
    "\n",
    "print(f\"Standardized features successfully (mean ≈ 0, std ≈ 1).\\n\")\n",
    "\n",
    "X_std_df = pd.DataFrame(X_std, columns=core_features)\n",
    "X_test_std_df = pd.DataFrame(X_test_std, columns=core_features)\n",
    "\n",
    "print(\"--- Standardized Train Data (X_std - 5 samples) ---\")\n",
    "display(X_std_df.head())\n",
    "\n",
    "print(\"\\n--- Standardized Test Data (X_test_std - 5 samples) ---\")\n",
    "display(X_test_std_df.head())\n",
    "\n",
    "# Assemble full DataFrames with identifiers and target\n",
    "train_std_df = train[[\"file_name\"]].copy()\n",
    "train_std_df[core_features] = X_std_df\n",
    "train_std_df[\"TARGET\"] = train[\"TARGET\"].values\n",
    "\n",
    "test_std_df = test[[\"file_name\"]].copy()\n",
    "test_std_df[core_features] = X_test_std_df\n",
    "if \"TARGET\" in test.columns:\n",
    "    test_std_df[\"TARGET\"] = test[\"TARGET\"].values\n",
    "\n",
    "# Output directories\n",
    "current_dir = Path(os.getcwd())\n",
    "word_output_dir = current_dir / \"output\" / \"word output\"\n",
    "word_output_dir.mkdir(parents=True, exist_ok=True)\n",
    "word_output_dir_alt = current_dir / \"output\" / \"Word output\"\n",
    "word_output_dir_alt.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Save standardized and raw split CSV files\n",
    "train_std_path = word_output_dir / \"train_standardized.csv\"\n",
    "test_std_path = word_output_dir / \"test_standardized.csv\"\n",
    "train_raw_path = word_output_dir / \"train.csv\"\n",
    "test_raw_path = word_output_dir / \"test.csv\"\n",
    "\n",
    "train_std_df.to_csv(train_std_path, index=False)\n",
    "test_std_df.to_csv(test_std_path, index=False)\n",
    "train.to_csv(train_raw_path, index=False)\n",
    "test.to_csv(test_raw_path, index=False)\n",
    "\n",
    "train_std_df.to_csv(word_output_dir_alt / \"train_standardized.csv\", index=False)\n",
    "test_std_df.to_csv(word_output_dir_alt / \"test_standardized.csv\", index=False)\n",
    "train.to_csv(word_output_dir_alt / \"train.csv\", index=False)\n",
    "test.to_csv(word_output_dir_alt / \"test.csv\", index=False)\n",
    "\n",
    "print(f\"\\nSuccessfully saved datasets to 'word output' folder:\")\n",
    "print(f\" - Standardized Train : {train_std_path} (shape: {train_std_df.shape})\")\n",
    "print(f\" - Standardized Test  : {test_std_path} (shape: {test_std_df.shape})\")\n",
    "print(f\" - Raw Train Split    : {train_raw_path} (shape: {train.shape})\")\n",
    "print(f\" - Raw Test Split     : {test_raw_path} (shape: {test.shape})\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<a name=\"sec5_3\"></a>\n",
    "### 5.3 Training the Model\n",
    "Perform a 70/30 stratified holdout split on training data and train the three models.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T09:53:18.753066Z",
     "iopub.status.busy": "2026-10-03T09:53:18.753066Z",
     "iopub.status.idle": "2026-10-03T09:53:18.762599Z",
     "shell.execute_reply": "2026-10-03T09:53:18.761591Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train size: 8,400 samples | Validation size: 3,600 samples\n"
     ]
    }
   ],
   "source": [
    "# Split the standardized training data into 70% train and 30% validation\n",
    "X_train, X_valid, y_train, y_valid = train_test_split(\n",
    "    X_std, y, test_size=0.3, stratify=y, random_state=0\n",
    ")\n",
    "\n",
    "print(f\"Train size: {X_train.shape[0]:,} samples | Validation size: {X_valid.shape[0]:,} samples\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T09:53:18.764598Z",
     "iopub.status.busy": "2026-10-03T09:53:18.764598Z",
     "iopub.status.idle": "2026-10-03T09:53:18.786149Z",
     "shell.execute_reply": "2026-10-03T09:53:18.785116Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Logistic Regression Validation ROC-AUC: 0.9998 | Accuracy: 0.9997\n"
     ]
    }
   ],
   "source": [
    "# Model 1: Logistic Regression\n",
    "lr = LogisticRegression(class_weight=\"balanced\", max_iter=1000, random_state=0)\n",
    "lr.fit(X_train, y_train)\n",
    "\n",
    "lr_val_auc = roc_auc_score(y_valid, lr.predict_proba(X_valid)[:, 1])\n",
    "lr_val_acc = accuracy_score(y_valid, lr.predict(X_valid))\n",
    "print(f\"Logistic Regression Validation ROC-AUC: {lr_val_auc:.4f} | Accuracy: {lr_val_acc:.4f}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T09:53:18.788292Z",
     "iopub.status.busy": "2026-10-03T09:53:18.787788Z",
     "iopub.status.idle": "2026-10-03T09:53:18.798805Z",
     "shell.execute_reply": "2026-10-03T09:53:18.798300Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Decision Tree Validation ROC-AUC: 0.9995 | Accuracy: 0.9994\n"
     ]
    }
   ],
   "source": [
    "# Model 2: Decision Tree\n",
    "dt = DecisionTreeClassifier(max_depth=6, min_samples_leaf=20, class_weight=\"balanced\", random_state=0)\n",
    "dt.fit(X_train, y_train)\n",
    "\n",
    "dt_val_auc = roc_auc_score(y_valid, dt.predict_proba(X_valid)[:, 1])\n",
    "dt_val_acc = accuracy_score(y_valid, dt.predict(X_valid))\n",
    "print(f\"Decision Tree Validation ROC-AUC: {dt_val_auc:.4f} | Accuracy: {dt_val_acc:.4f}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T09:53:18.800924Z",
     "iopub.status.busy": "2026-10-03T09:53:18.800924Z",
     "iopub.status.idle": "2026-10-03T09:53:19.340766Z",
     "shell.execute_reply": "2026-10-03T09:53:19.339757Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Random Forest Validation ROC-AUC: 0.9998 | Accuracy: 0.9997\n"
     ]
    }
   ],
   "source": [
    "# Model 3: Random Forest\n",
    "rf = RandomForestClassifier(n_estimators=200, max_depth=16, class_weight=\"balanced\", random_state=0, n_jobs=-1)\n",
    "rf.fit(X_train, y_train)\n",
    "\n",
    "rf_val_auc = roc_auc_score(y_valid, rf.predict_proba(X_valid)[:, 1])\n",
    "rf_val_acc = accuracy_score(y_valid, rf.predict(X_valid))\n",
    "print(f\"Random Forest Validation ROC-AUC: {rf_val_auc:.4f} | Accuracy: {rf_val_acc:.4f}\")\n"
   ]
  },
