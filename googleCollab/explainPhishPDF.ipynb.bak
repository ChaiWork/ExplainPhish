   "source": [
    "<a name=\"sec5_4_3\"></a>\n",
    "#### 5.4.3 Random Forest Visualizations\n",
    "1. **MDI Feature Importance with Standard Deviation Error Bars**: Displays mean importance across all 200 trees along with inter-tree variance.\n",
    "2. **Tree Depth Distribution**: Analyzes the depth of individual estimators across the ensemble.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T08:15:25.220691Z",
     "iopub.status.busy": "2026-10-03T08:15:25.220691Z",
     "iopub.status.idle": "2026-10-03T08:15:25.569706Z",
     "shell.execute_reply": "2026-10-03T08:15:25.569195Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Random Forest Feature Importance with Inter-Tree Standard Deviation\n",
    "importances = rf.feature_importances_\n",
    "std = np.std([tree.feature_importances_ for tree in rf.estimators_], axis=0)\n",
    "indices = np.argsort(importances)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 5))\n",
    "\n",
    "# Plot 1: Feature Importances\n",
    "axes[0].barh(range(len(indices)), importances[indices], xerr=std[indices], color=\"#2980b9\", capsize=4, align=\"center\")\n",
    "axes[0].set_yticks(range(len(indices)))\n",
    "axes[0].set_yticklabels([use_features[i] for i in indices])\n",
    "axes[0].set_title(\"Random Forest MDI Feature Importance (with Tree Variance)\", fontweight=\"bold\")\n",
    "axes[0].set_xlabel(\"Mean Decrease in Impurity\")\n",
    "\n",
    "# Plot 2: Tree Depths\n",
    "tree_depths = [tree.tree_.max_depth for tree in rf.estimators_]\n",
    "sns.histplot(tree_depths, bins=10, kde=True, ax=axes[1], color=\"#8e44ad\")\n",
    "axes[1].axvline(np.mean(tree_depths), color=\"red\", linestyle=\"--\", label=f\"Mean Depth: {np.mean(tree_depths):.1f}\")\n",
    "axes[1].set_title(\"Random Forest Estimator Tree Depth Distribution\", fontweight=\"bold\")\n",
    "axes[1].set_xlabel(\"Tree Depth\")\n",
    "axes[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<a name=\"sec5_4_4\"></a>\n",
    "#### 5.4.4 Multi-Model Comparison (ROC Curves, Confusion Matrices, & Metrics)\n",
    "We benchmark all three algorithms alongside the Voting Ensemble.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T08:15:25.571711Z",
     "iopub.status.busy": "2026-10-03T08:15:25.571711Z",
     "iopub.status.idle": "2026-10-03T08:15:25.794430Z",
     "shell.execute_reply": "2026-10-03T08:15:25.793421Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Generate Predictions & ROC Curves for all 3 models and Voting Ensemble\n",
    "p_lr = lr.predict_proba(X_valid)[:, 1]\n",
    "p_dt = dt.predict_proba(X_valid)[:, 1]\n",
    "p_rf = rf.predict_proba(X_valid)[:, 1]\n",
    "p_vote = (p_lr + p_dt + p_rf) / 3\n",
    "\n",
    "fpr_lr, tpr_lr, _ = roc_curve(y_valid, p_lr)\n",
    "fpr_dt, tpr_dt, _ = roc_curve(y_valid, p_dt)\n",
    "fpr_rf, tpr_rf, _ = roc_curve(y_valid, p_rf)\n",
    "fpr_vote, tpr_vote, _ = roc_curve(y_valid, p_vote)\n",
    "\n",
    "plt.figure(figsize=(9, 6))\n",
    "plt.plot(fpr_rf, tpr_rf, label=f\"Random Forest (AUC = {rf_val_auc:.4f})\", color=\"#2980b9\", lw=2.5)\n",
    "plt.plot(fpr_vote, tpr_vote, label=f\"Voting Ensemble (AUC = {roc_auc_score(y_valid, p_vote):.4f})\", color=\"#27ae60\", lw=2, linestyle=\"-.\")\n",
    "plt.plot(fpr_dt, tpr_dt, label=f\"Decision Tree (AUC = {dt_val_auc:.4f})\", color=\"#f39c12\", lw=2)\n",
    "plt.plot(fpr_lr, tpr_lr, label=f\"Logistic Regression (AUC = {lr_val_auc:.4f})\", color=\"#e74c3c\", lw=2)\n",
    "plt.plot([0, 1], [0, 1], \"k--\", alpha=0.5, label=\"Random Guess (AUC = 0.5000)\")\n",
    "plt.xlabel(\"False Positive Rate (1 - Specificity)\")\n",
    "plt.ylabel(\"True Positive Rate (Sensitivity / Recall)\")\n",
    "plt.title(\"Comparative ROC Curves Across Multi-Model Ensemble\", fontweight=\"bold\")\n",
    "plt.legend(loc=\"lower right\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-03T08:15:25.796434Z",
     "iopub.status.busy": "2026-10-03T08:15:25.796434Z",
